<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <AssemblyName>freedom</AssemblyName>
    <AssemblyTitle>freedom</AssemblyTitle>
    <Product>freedom</Product>
    <Description>freedom Windows proxy client</Description>
    <RootNamespace>v2rayN.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\freedom.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Managed WinUI builds do not need vcmeta. Avoid a Windows App SDK probe that crashes when VS lacks C++ tools. -->
    <VCInstallPath32 Condition="'$(VCToolsInstallDir)' == '' and '$(VsInstallRoot)' != '' and !Exists('$(VsInstallRoot)\VC\Tools\MSVC')">NUL</VCInstallPath32>
    <VCInstallPath64 Condition="'$(VCToolsInstallDir)' == '' and '$(VsInstallRoot)' != '' and !Exists('$(VsInstallRoot)\VC\Tools\MSVC')">NUL</VCInstallPath64>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="ReactiveUI.WinUI" />
    <PackageReference Include="System.Drawing.Common" />
    <ProjectReference Include="..\ServiceLib\ServiceLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\freedom.ico" />
    <Content Include="Assets\freedom.png" />
    <Content Include="Assets\NotifyIcon*.ico" />
  </ItemGroup>

  <Target Name="BuildUpgradeTool" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild
      Projects="..\AmazTool\AmazTool.csproj"
      Targets="Restore;Build"
      Properties="Configuration=$(Configuration);Platform=AnyCPU;UpgradeToolDestination=$(TargetDir)" />
  </Target>

  <Target Name="CopyWinUIResourcesToPublishDirectory" AfterTargets="Publish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI application PRI resource was not generated." />
    <Error Condition="!Exists('$(TargetDir)App.xbf') or !Exists('$(TargetDir)MainWindow.xbf')" Text="WinUI application XBF resources were not generated." />

    <ItemGroup>
      <_WinUIRootResource Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)App.xbf;$(TargetDir)MainWindow.xbf" />
      <_WinUIViewResource Include="$(TargetDir)Views\**\*.xbf" />
      <_WinUIAsset Include="$(TargetDir)Assets\**\*" />
      <_AmazToolPublishFile Include="$(TargetDir)AmazTool.*" />
      <_AmazToolZhHansResource Include="$(TargetDir)zh-Hans\AmazTool.resources.dll" />
      <_AmazToolZhHantResource Include="$(TargetDir)zh-Hant\AmazTool.resources.dll" />
    </ItemGroup>

    <Error Condition="'@(_WinUIViewResource)' == ''" Text="WinUI view XBF resources were not generated." />
    <Error Condition="'@(_WinUIAsset)' == ''" Text="WinUI assets were not generated." />
    <Error Condition="'@(_AmazToolPublishFile)' == '' or !Exists('$(TargetDir)AmazTool.exe')" Text="AmazTool proxy guard was not generated." />

    <Copy SourceFiles="@(_WinUIRootResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIViewResource)" DestinationFiles="@(_WinUIViewResource->'$(PublishDir)Views\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIAsset)" DestinationFiles="@(_WinUIAsset->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AmazToolPublishFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AmazToolZhHansResource)" DestinationFolder="$(PublishDir)zh-Hans" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AmazToolZhHantResource)" DestinationFolder="$(PublishDir)zh-Hant" SkipUnchangedFiles="true" />
  </Target>

</Project>
