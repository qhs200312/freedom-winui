<Window
    x:Class="v2rayN.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:v2rayN.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.Resources>
        <MenuFlyout x:Key="ProfileContextMenu">
            <MenuFlyoutItem Text="设为主节点" Tag="profile-activate" Click="FeatureButton_Click">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Accept" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="编辑" Tag="edit-server" Click="FeatureButton_Click">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="复制" Tag="copy-server" Click="FeatureButton_Click">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="删除" Tag="remove-server" Click="FeatureButton_Click">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutSubItem Text="测试">
                <MenuFlyoutItem Text="TCP Ping" Tag="tcp-ping" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="真实延迟" Tag="real-ping" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="UDP 测试" Tag="udp-test" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="测速" Tag="speed-test" Click="FeatureButton_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="综合测试" Tag="mixed-test" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="快速延迟" Tag="fast-ping" Click="FeatureButton_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="移动">
                <MenuFlyoutItem Text="置顶" Tag="move-top" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="上移" Tag="move-up" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="下移" Tag="move-down" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="置底" Tag="move-bottom" Click="FeatureButton_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="导出">
                <MenuFlyoutItem Text="分享当前节点" Tag="export" Click="FeatureButton_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="导出客户端配置" Tag="export-client" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="客户端配置到剪贴板" Tag="export-client-clipboard" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="导出分享链接" Tag="export-url" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="导出 Base64" Tag="export-base64" Click="FeatureButton_Click" />
                <MenuFlyoutItem Text="导出内部 URI" Tag="export-inner" Click="FeatureButton_Click" />
            </MenuFlyoutSubItem>
        </MenuFlyout>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid x:Name="AppTitleBar" Padding="12,0,0,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="16" Height="16" HorizontalAlignment="Left" Source="Assets/freedom.png" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="freedom" />
            </Grid>
        </Grid>

        <!-- Custom left nav: NavigationView selection/hit-testing is unreliable with custom title bars. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource AppBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Height="48" Margin="16,4,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="8">
                            <Image Stretch="UniformToFill" Source="Assets/freedom.png" />
                        </Border>
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" Text="freedom" />
                    </Grid>

                    <ListView
                        x:Name="NavList"
                        Grid.Row="1"
                        Margin="8,0,8,4"
                        SelectionChanged="NavList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.Resources>
                            <CornerRadius x:Key="ListViewItemCornerRadius">12</CornerRadius>
                            <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#08007FFF" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#18007FFF" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#14007FFF" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#20007FFF" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2C007FFF" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="44" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListViewItem Tag="dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Home" />
                                <TextBlock VerticalAlignment="Center" Text="仪表盘" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="profiles">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="List" />
                                <TextBlock VerticalAlignment="Center" Text="配置项" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="subscriptions">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Sync" />
                                <TextBlock VerticalAlignment="Center" Text="订阅管理" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="logs">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Message" />
                                <TextBlock VerticalAlignment="Center" Text="运行日志" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="unlock">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="World" />
                                <TextBlock VerticalAlignment="Center" Text="解锁测试" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="updates">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock VerticalAlignment="Center" Text="组件更新" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="settings">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Setting" />
                                <TextBlock VerticalAlignment="Center" Text="设置" />
                            </StackPanel>
                        </ListViewItem>
                    </ListView>

                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{ThemeResource AppBackgroundBrush}">
                <ScrollViewer x:Name="DashboardPage" HorizontalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" SizeChanged="DashboardPage_SizeChanged" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="DashboardContentGrid" MaxWidth="1600" Padding="24,18,24,24" HorizontalAlignment="Center" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="DashboardHeaderGrid" Margin="0,0,0,6">
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" Text="仪表盘" />
                            <Border x:Name="HeaderStatusPanel" Width="42" Height="42" CornerRadius="21" HorizontalAlignment="Right" Background="{ThemeResource StatusSurfaceBrush}" ToolTipService.ToolTip="内核运行状态">
                                <FontIcon x:Name="HeaderStateGlyph" Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource StatusForegroundBrush}" />
                            </Border>
                        </Grid>
                        <Grid x:Name="MetricGrid" Grid.Row="1" ColumnSpacing="14" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="MetricColumn3" Width="*" />
                                <ColumnDefinition x:Name="MetricColumn4" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ActiveServerCard" Grid.ColumnSpan="2" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="0" Height="202">
                                <Grid CornerRadius="30">
                                    <Path HorizontalAlignment="Right" Width="228" Stretch="Fill" Fill="{ThemeResource HeroWashBrush}" Data="M 28,0 L 228,0 L 228,202 L 40,202 C 54,180 3,180 15,152 C 30,122 0,127 7,95 C 15,62 0,60 24,35 C 38,20 28,8 28,0 Z" />
                                    <Grid Padding="22" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="102" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Text="状态" FontSize="13" VerticalAlignment="Center" />
                                            <Border x:Name="CoreStatusBadge" CornerRadius="12" Padding="10,3" Background="{ThemeResource StatusSurfaceBrush}">
                                                <TextBlock x:Name="CoreStatusText" FontSize="12" Foreground="{ThemeResource StatusForegroundBrush}" Text="正在初始化" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="5">
                                            <TextBlock x:Name="ActiveServerText" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" Text="未选择服务器" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="ActiveServerDetailText" Style="{StaticResource QuietTextStyle}" Text="在配置项中选择节点" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid Grid.Row="2" ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="运行时长" FontSize="13" Foreground="{ThemeResource MutedTextBrush}" />
                                                <TextBlock x:Name="CoreUptimeText" Text="00:00:00" FontSize="14" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="当前节点" FontSize="13" Foreground="{ThemeResource MutedTextBrush}" />
                                                <TextBlock x:Name="ActiveServerHeaderText" FontSize="12" Text="等待选择" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <controls:CoreConnectionButton x:Name="CoreToggleButton" Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ConnectionButtonStyle}" Click="CoreToggle_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="UploadCard" Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="0" Height="202">
                                <Grid CornerRadius="30">
                                    <StackPanel Margin="22,20,22,0" Spacing="6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74A;" FontSize="15" />
                                                <TextBlock Text="上传" FontSize="13" />
                                            </StackPanel>
                                            <TextBlock x:Name="UploadPeakText" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" Text="峰值 0 B/s" />
                                        </Grid>
                                        <TextBlock x:Name="UploadSpeedText" Margin="0,10,0,0" Style="{StaticResource MetricValueStyle}" FontSize="36">
                                            <Run x:Name="UploadSpeedValueText" Text="0" /><Run x:Name="UploadSpeedUnitText" Text=" B/s" FontSize="12" FontWeight="Normal" />
                                        </TextBlock>
                                        <TextBlock x:Name="UploadTotalText" Style="{StaticResource QuietTextStyle}" FontSize="13" Text="累计 0 B" />
                                    </StackPanel>
                                    <controls:SmoothTrafficChart x:Name="UploadSparkline" Height="44" VerticalAlignment="Bottom" VisibleSampleCount="60" Series="Upload" />
                                </Grid>
                            </Border>
                            <Border x:Name="DownloadCard" Grid.Column="3" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="0" Height="202">
                                <Grid CornerRadius="30">
                                    <StackPanel Margin="22,20,22,0" Spacing="6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74B;" FontSize="15" Foreground="{ThemeResource BrandBrush}" />
                                                <TextBlock Text="下载" FontSize="13" />
                                            </StackPanel>
                                            <TextBlock x:Name="DownloadPeakText" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" Text="峰值 0 B/s" />
                                        </Grid>
                                        <TextBlock x:Name="DownloadSpeedText" Margin="0,10,0,0" Style="{StaticResource MetricValueStyle}" FontSize="36">
                                            <Run x:Name="DownloadSpeedValueText" Text="0" /><Run x:Name="DownloadSpeedUnitText" Text=" B/s" FontSize="12" FontWeight="Normal" />
                                        </TextBlock>
                                        <TextBlock x:Name="DownloadTotalText" Style="{StaticResource QuietTextStyle}" FontSize="13" Text="累计 0 B" />
                                    </StackPanel>
                                    <controls:SmoothTrafficChart x:Name="DownloadSparkline" Height="44" VerticalAlignment="Bottom" VisibleSampleCount="60" Series="Download" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid x:Name="ControlGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ControlColumn3" Width="*" />
                                <ColumnDefinition x:Name="ControlColumn4" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RoutingCard" Grid.ColumnSpan="2" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" CornerRadius="28" Padding="8" MinHeight="64">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="RoutingLabelPanel" Orientation="Horizontal" Spacing="8" Margin="12,0,4,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Text="出站模式" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid x:Name="RoutingModeSelector" Grid.Column="1" ColumnSpacing="3" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <RadioButton x:Name="RoutingRulesButton" GroupName="OutboundMode" Tag="Rules" Checked="OutboundMode_Checked" Style="{StaticResource OutboundModeButtonStyle}" AutomationProperties.Name="绕过大陆" ToolTipService.ToolTip="中国大陆直连，其他流量走代理">
                                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE80A;" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="绕过大陆" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RoutingGlobalButton" Grid.Column="1" GroupName="OutboundMode" Tag="Global" Checked="OutboundMode_Checked" Style="{StaticResource OutboundModeButtonStyle}" AutomationProperties.Name="全局代理" ToolTipService.ToolTip="全局代理">
                                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE774;" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="全局代理" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                                        </RadioButton>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="SystemProxyCard" Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" CornerRadius="28" Padding="14,10" MinHeight="64">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="12" Background="{ThemeResource BrandBrush}">
                                        <FontIcon Glyph="&#xE774;" FontSize="17" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="系统代理" FontSize="13" />
                                        <ComboBox x:Name="ProxyModeCombo" MinHeight="23" Padding="0" FontSize="11" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" SelectionChanged="ProxyModeCombo_SelectionChanged" AutomationProperties.Name="系统代理模式">
                                            <ComboBoxItem Content="关闭系统代理" Tag="0" />
                                            <ComboBoxItem Content="自动配置系统代理" Tag="1" />
                                            <ComboBoxItem Content="保持系统代理" Tag="2" />
                                            <ComboBoxItem Content="PAC 模式" Tag="3" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="TunCard" Grid.Column="3" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" CornerRadius="28" Padding="14,10" MinHeight="64">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="12" Background="{ThemeResource BrandBrush}">
                                        <FontIcon Glyph="&#xE83D;" FontSize="17" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="虚拟网卡" FontSize="13" />
                                        <TextBlock x:Name="TunStateText" Text="未开启" FontSize="13" Foreground="{ThemeResource MutedTextBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" x:Name="TunToggle" MinWidth="0" OffContent="" OnContent="" Toggled="TunToggle_Toggled" AutomationProperties.Name="虚拟网卡" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid x:Name="DetailGrid" Grid.Row="3" ColumnSpacing="14" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="DetailColumn3" Width="*" />
                                <ColumnDefinition x:Name="DetailColumn4" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="OutboundIpCard" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="20,16" MinHeight="176">
                                <Grid RowSpacing="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                                            <TextBlock Text="出口 IP" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock x:Name="NodeLatencyText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource MutedTextBrush}" Text="未测试" Margin="0,0,22,0" ToolTipService.ToolTip="当前节点真实延迟" />
                                        <ProgressRing x:Name="OutboundIpProgress" Width="16" Height="16" HorizontalAlignment="Right" IsActive="False" />
                                    </Grid>
                                    <TextBlock x:Name="OutboundIpText" Grid.Row="1" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" Text="--" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                    <Grid Grid.Row="2" ColumnSpacing="8" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <controls:CountryFlag x:Name="OutboundCountryFlag" VerticalAlignment="Center" />
                                        <TextBlock x:Name="OutboundIpDetailText" Grid.Column="1" Style="{StaticResource QuietTextStyle}" FontSize="14" Text="等待检测" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="UdpInterceptionStatusText" Grid.Row="3" FontSize="13" Foreground="{ThemeResource MutedTextBrush}" Text="UDP 接管：关闭" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="5">
                                        <Button x:Name="RefreshOutboundIpButton" Style="{StaticResource DashboardIconButtonStyle}" Click="RefreshOutboundIp_Click" ToolTipService.ToolTip="刷新出口 IP 和节点延迟" AutomationProperties.Name="刷新出口 IP 和节点延迟">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        </Button>
                                        <Button x:Name="RefreshNodeLatencyButton" Style="{StaticResource DashboardIconButtonStyle}" Click="RefreshNodeLatency_Click" ToolTipService.ToolTip="检测节点延迟">
                                            <FontIcon Glyph="&#xE917;" FontSize="14" />
                                        </Button>
                                        <Button x:Name="CopyOutboundIpButton" Style="{StaticResource DashboardIconButtonStyle}" Click="CopyOutboundIp_Click" IsEnabled="False" ToolTipService.ToolTip="复制出口 IP">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                        <Button x:Name="OutboundIpDetailsButton" Style="{StaticResource DashboardIconButtonStyle}" Click="OutboundIpDetails_Click" IsEnabled="False" ToolTipService.ToolTip="详细 IP 信息">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="TotalTrafficCard" Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="20,16" MinHeight="176">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                        <TextBlock Text="本次流量" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock x:Name="TotalTrafficText" Style="{StaticResource MetricValueStyle}" FontSize="26" Text="0 B" />
                                        <TextBlock x:Name="TotalTrafficDetailText" Style="{StaticResource QuietTextStyle}" FontSize="13" Text="上传 0 B · 下载 0 B" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="NetworkStatusCard" Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="20,16" MinHeight="176">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="14" /><TextBlock Text="已用总流量" FontSize="13" /></StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock x:Name="LifetimeTrafficText" Style="{StaticResource MetricValueStyle}" FontSize="28" Text="0 B" />
                                        <TextBlock x:Name="LifetimeTrafficDetailText" Style="{StaticResource QuietTextStyle}" FontSize="13" Text="上传 0 B · 下载 0 B" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="MemoryCard" Grid.Column="3" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="20,16" MinHeight="176">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE950;" FontSize="14" /><TextBlock x:Name="CoreMemoryTitleText" Text="核心内存" FontSize="13" /></StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock x:Name="CoreMemoryText" Text="--" FontSize="30" FontWeight="SemiBold" /><TextBlock x:Name="CoreMemoryUnitText" Text="MB" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,5" /></StackPanel>
                                        <TextBlock x:Name="MemoryDetailText" Text="尚未启动核心" FontSize="14" Foreground="{ThemeResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid x:Name="BottomGrid" Grid.Row="4" ColumnSpacing="14" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition x:Name="BottomColumn2" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TrafficChartCard" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="20,16" MinHeight="222">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border CornerRadius="14" Background="{ThemeResource BrandBrush}" Padding="12,6">
                                                <TextBlock Text="实时流量" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <TextBlock Foreground="{StaticResource UploadChartBrush}" Text="● 上传" FontSize="11" />
                                                <TextBlock Foreground="{StaticResource DownloadChartBrush}" Text="● 下载" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietTextStyle}" FontSize="13" Text="最近 60 秒" />
                                    </Grid>
                                    <Grid Grid.Row="1" MinHeight="144">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid x:Name="YAxisLabelPanel" Margin="0,0,8,0">
                                            <TextBlock x:Name="YAxisTopLabel" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" Text="1 KB/s" />
                                            <TextBlock x:Name="YAxisMidLabel" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" Text="0.5 KB/s" />
                                            <TextBlock x:Name="YAxisBottomLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" Text="0 B/s" />
                                        </Grid>
                                        <Grid x:Name="TrafficCanvas" Grid.Column="1" MinHeight="120" SizeChanged="TrafficCanvas_SizeChanged">
                                            <Line x:Name="AxisBottom" Stroke="{ThemeResource PanelStrokeBrush}" StrokeThickness="1" />
                                            <Line x:Name="AxisMiddle" Stroke="{ThemeResource PanelStrokeBrush}" StrokeThickness="1" StrokeDashArray="3,4" />
                                            <Line x:Name="AxisTop" Stroke="{ThemeResource PanelStrokeBrush}" StrokeThickness="1" StrokeDashArray="3,4" />
                                            <controls:SmoothTrafficChart x:Name="MainTrafficGraph" VisibleSampleCount="60" />
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                            <TextBlock x:Name="XAxisLeftLabel" HorizontalAlignment="Left" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" Text="-60s" />
                                            <TextBlock x:Name="XAxisMidLabel" HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" Text="-30s" />
                                            <TextBlock x:Name="XAxisRightLabel" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" Text="现在" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="QuickAccessCard" Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Translation="0,0,8" Padding="20,16" MinHeight="222">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                                        <FontIcon Glyph="&#xE8A9;" FontSize="15" />
                                        <TextBlock Text="快捷入口" FontSize="13" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Background="{ThemeResource InsetBrush}" BorderThickness="0" CornerRadius="18" Tag="profiles" Click="DashboardNavigate_Click">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource BrandBrush}" FontSize="19" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="节点与配置" FontSize="13" />
                                                    <TextBlock Text="选择、导入与管理服务器" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <FontIcon HorizontalAlignment="Right" Glyph="&#xE76C;" FontSize="11" />
                                        </Grid>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Background="{ThemeResource InsetBrush}" BorderThickness="0" CornerRadius="18" Tag="unlock" Click="DashboardNavigate_Click">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE774;" Foreground="{ThemeResource BrandBrush}" FontSize="19" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="服务可用性" FontSize="13" />
                                                    <TextBlock Text="检测流媒体与 AI 服务" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <FontIcon HorizontalAlignment="Right" Glyph="&#xE76C;" FontSize="11" />
                                        </Grid>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8" Background="Transparent" BorderThickness="0" CornerRadius="14" Tag="logs" Click="DashboardNavigate_Click">
                                        <Grid>
                                            <TextBlock Text="查看运行日志" FontSize="14" Foreground="{ThemeResource MutedTextBrush}" />
                                            <FontIcon HorizontalAlignment="Right" Glyph="&#xE76C;" FontSize="11" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="ProfilesPage" Visibility="Collapsed" Padding="32,26,32,30">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" FontSize="28" Text="配置项" /><TextBlock Margin="0,5,0,0" Style="{StaticResource QuietTextStyle}" Text="服务器列表与完整管理操作" /></StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ProfileGroupCombo" Width="220" Header="订阅分组" DisplayMemberPath="Remarks" SelectionChanged="ProfileGroupCombo_SelectionChanged" />
                            <TextBox x:Name="ProfileSearchBox" Width="280" Header="筛选" PlaceholderText="名称、地址或订阅" TextChanged="ProfileSearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Tag="profile-activate"
                            Click="FeatureButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Accept" />
                                <TextBlock Text="设为主节点" />
                            </StackPanel>
                        </Button>

                        <MenuBar Grid.Column="1" HorizontalAlignment="Left">
                            <MenuBarItem Title="添加">
                                <MenuFlyoutItem Text="从剪贴板导入" Tag="add-clipboard" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="从图片识别" Tag="add-image" Click="FeatureButton_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="添加服务器">
                                    <MenuFlyoutItem Text="VMess" Tag="vmess" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="VLESS" Tag="vless" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="Shadowsocks" Tag="shadowsocks" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="SOCKS" Tag="socks" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="HTTP" Tag="http" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="Trojan" Tag="trojan" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="Hysteria2" Tag="hysteria2" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="TUIC" Tag="tuic" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="WireGuard" Tag="wireguard" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="AnyTLS" Tag="anytls" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="NaiveProxy" Tag="naive" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="Nowhere" Tag="nowhere" Click="AddProtocol_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="自定义配置" Tag="custom" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="策略组" Tag="policy" Click="AddProtocol_Click" />
                                    <MenuFlyoutItem Text="代理链" Tag="chain" Click="AddProtocol_Click" />
                                </MenuFlyoutSubItem>
                            </MenuBarItem>

                            <MenuBarItem Title="管理">
                                <MenuFlyoutItem Text="编辑" Tag="edit-server" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="复制" Tag="copy-server" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="删除" Tag="remove-server" Click="FeatureButton_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="去除重复节点" Tag="deduplicate" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="清理无效节点" Tag="remove-invalid" Click="FeatureButton_Click" />
                            </MenuBarItem>

                            <MenuBarItem Title="测试">
                                <MenuFlyoutItem Text="TCP Ping" Tag="tcp-ping" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="真实延迟" Tag="real-ping" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="UDP 测试" Tag="udp-test" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="测速" Tag="speed-test" Click="FeatureButton_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="综合测试" Tag="mixed-test" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="快速延迟" Tag="fast-ping" Click="FeatureButton_Click" />
                            </MenuBarItem>

                            <MenuBarItem Title="排序">
                                <MenuFlyoutItem Text="按测试结果排序" Tag="sort-results" Click="FeatureButton_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="按类型" Tag="ConfigType" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按备注" Tag="Remarks" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按地址" Tag="Address" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按端口" Tag="Port" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按传输" Tag="Network" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按 TLS" Tag="StreamSecurity" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按订阅" Tag="SubRemarks" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按延迟" Tag="DelayVal" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按速度" Tag="SpeedVal" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按今日上传" Tag="TodayUp" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按今日下载" Tag="TodayDown" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按总上传" Tag="TotalUp" Click="SortColumnMenuItem_Click" />
                                <MenuFlyoutItem Text="按总下载" Tag="TotalDown" Click="SortColumnMenuItem_Click" />
                            </MenuBarItem>

                            <MenuBarItem Title="移动">
                                <MenuFlyoutItem Text="置顶" Tag="move-top" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="上移" Tag="move-up" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="下移" Tag="move-down" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="置底" Tag="move-bottom" Click="FeatureButton_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="MoveToGroupMenu" Text="移动到分组" />
                            </MenuBarItem>

                            <MenuBarItem Title="导出">
                                <MenuFlyoutItem Text="分享当前节点" Tag="export" Click="FeatureButton_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="导出客户端配置" Tag="export-client" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="客户端配置到剪贴板" Tag="export-client-clipboard" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="导出分享链接" Tag="export-url" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="导出 Base64" Tag="export-base64" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="导出内部 URI" Tag="export-inner" Click="FeatureButton_Click" />
                            </MenuBarItem>

                            <MenuBarItem Title="策略组">
                                <MenuFlyoutItem Text="全部节点生成策略组" Tag="generate-all" Click="FeatureButton_Click" />
                                <MenuFlyoutItem Text="按地区生成策略组" Tag="generate-region" Click="FeatureButton_Click" />
                            </MenuBarItem>
                        </MenuBar>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Padding="14,0" Background="{ThemeResource AccentSoftBrush}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="类型" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="备注" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="地址" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="端口" /><TextBlock Grid.Column="4" VerticalAlignment="Center" Text="传输" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="TLS" /><TextBlock Grid.Column="6" VerticalAlignment="Center" Text="订阅" /><TextBlock Grid.Column="7" VerticalAlignment="Center" Text="延迟" />
                            </Grid>
                            <ListView x:Name="ProfilesList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="ProfilesList_ItemClick" DoubleTapped="ProfilesList_DoubleTapped" KeyDown="ProfilesList_KeyDown" SelectionChanged="ProfilesList_SelectionChanged" SelectionMode="Extended" ContextRequested="ProfilesList_ContextRequested" ContextCanceled="ProfilesList_ContextCanceled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="42" Padding="10,0" ColumnSpacing="12" Background="Transparent">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding ConfigType}" />
                                            <Grid Grid.Column="1" ColumnSpacing="5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}" FontSize="12" FontWeight="SemiBold" Text="{Binding ActiveLabel}" ToolTipService.ToolTip="主节点" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Remarks}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Cascadia Mono" Text="{Binding Address}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Port}" /><TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Network}" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding StreamSecurity}" /><TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding SubRemarks}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{Binding DelayVal}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ModulePage" Visibility="Collapsed" Padding="32,26,32,30">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="ModuleTitleText" Style="{StaticResource SectionTitleStyle}" FontSize="28" Text="功能" /><TextBlock x:Name="ModuleSubtitleText" Margin="0,5,0,0" Style="{StaticResource QuietTextStyle}" /></StackPanel>
                    <ContentControl x:Name="ModuleContent" Grid.Row="1" Margin="0,18,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>

                <StackPanel Margin="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8" MaxWidth="400">
                    <StackPanel x:Name="UpdateNotifications" Spacing="8" />
                    <InfoBar x:Name="MessageBar" Background="{ThemeResource BrandPanelBrush}" BorderBrush="{ThemeResource BrandPanelStrokeBrush}" Foreground="{ThemeResource BrandBrush}" IsClosable="True" IsOpen="False" MaxWidth="400" Severity="Informational" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
