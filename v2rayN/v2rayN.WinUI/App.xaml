<Application
    x:Class="v2rayN.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F8FA" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#D9E3E7" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#60747C" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#087F86" Opacity="0.14" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101719" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#172124" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#2C3C41" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CB0B7" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#087F86" Opacity="0.22" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="BrandBrush" Color="#087F86" />
            <SolidColorBrush x:Key="BrandPanelBrush" Color="#DDF3F0" />
            <SolidColorBrush x:Key="BrandPanelStrokeBrush" Color="#A8D8D1" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#108B6A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#CF7D17" />

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="27" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="QuietTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="MenuBar">
                <Setter Property="Background" Value="{ThemeResource BrandPanelBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource BrandBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BrandPanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style TargetType="MenuBarItem">
                <Setter Property="Foreground" Value="{ThemeResource BrandBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
