<Application
    x:Class="v2rayN.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EFEDF0" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FCFAFC" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#E5E2E8" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6B76" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#007FFF" Opacity="0.10" />
                    <SolidColorBrush x:Key="InsetBrush" Color="#F0EDF2" />
                    <SolidColorBrush x:Key="HeroWashBrush" Color="#E3EBFF" />
                    <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#AEF5B4" />
                    <SolidColorBrush x:Key="StatusForegroundBrush" Color="#125B2A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101719" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#172124" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#2C3C41" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CB0B7" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#087F86" Opacity="0.22" />
                    <SolidColorBrush x:Key="InsetBrush" Color="#282D36" />
                    <SolidColorBrush x:Key="HeroWashBrush" Color="#1E355B" />
                    <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#224B34" />
                    <SolidColorBrush x:Key="StatusForegroundBrush" Color="#AEF5B4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="BrandBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="BrandPanelBrush" Color="#E5EFFF" />
            <SolidColorBrush x:Key="BrandPanelStrokeBrush" Color="#C5DCFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#108B6A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#CF7D17" />
            <SolidColorBrush x:Key="UploadChartBrush" Color="#89BDF8" />
            <SolidColorBrush x:Key="DownloadChartBrush" Color="#007FFF" />

            <Style x:Key="OutboundModeButtonStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="ModeSurface" Background="{ThemeResource InsetBrush}" CornerRadius="23" Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ModeSurface.Opacity" Value="0.86" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ModeSurface.Opacity" Value="0.7" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ModeSurface.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="ModeSurface.Background" Value="{ThemeResource BrandBrush}" />
                                                <Setter Target="ModeSurface.CornerRadius" Value="23" />
                                                <Setter Target="ModeContent.Foreground" Value="White" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ModeContent" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="30" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="Shadow"><Setter.Value><ThemeShadow /></Setter.Value></Setter>
            </Style>
            <Style x:Key="ConnectionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="96" />
                <Setter Property="Height" Value="96" />
                <Setter Property="CornerRadius" Value="44" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ConnectionBadge.Opacity" Value="0.86" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ConnectionBadge.Opacity" Value="0.7" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ConnectionBadge.Opacity" Value="0.35" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Path x:Name="ConnectionBadge" Width="96" Height="96" Fill="{ThemeResource BrandBrush}" Data="M 48,2 C 52.82,2 56.38,8.66 60.36,9.96 C 64.34,11.25 71.14,7.95 75.04,10.79 C 78.94,13.62 77.9,21.1 80.36,24.49 C 82.82,27.88 90.26,29.2 91.75,33.79 C 93.24,38.37 88,43.81 88,48 C 88,52.19 93.24,57.63 91.75,62.21 C 90.26,66.8 82.82,68.12 80.36,71.51 C 77.9,74.9 78.94,82.38 75.04,85.21 C 71.14,88.05 64.34,84.75 60.36,86.04 C 56.38,87.34 52.82,94 48,94 C 43.18,94 39.62,87.34 35.64,86.04 C 31.66,84.75 24.86,88.05 20.96,85.21 C 17.06,82.38 18.1,74.9 15.64,71.51 C 13.18,68.12 5.74,66.8 4.25,62.21 C 2.76,57.63 8,52.19 8,48 C 8,43.81 2.76,38.37 4.25,33.79 C 5.74,29.2 13.18,27.88 15.64,24.49 C 18.1,21.1 17.06,13.62 20.96,10.79 C 24.86,7.95 31.66,11.25 35.64,9.96 C 39.62,8.66 43.18,2 48,2 Z" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DashboardIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="27" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="QuietTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="MenuBar">
                <Setter Property="Background" Value="{ThemeResource BrandPanelBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource BrandBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BrandPanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style TargetType="MenuBarItem">
                <Setter Property="Foreground" Value="{ThemeResource BrandBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
